# Next.js environment (.env.local). `npx convex dev` writes the Convex URLs.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set ALL remaining values on the Convex backend, not NEXT_PUBLIC_ variables.
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OPERATOR_EMAIL=
# Enable only while creating your operator account on a private/local instance.
ALLOW_SIGNUP=false

# Stripe restricted key: read Customers, Subscriptions, Prices and Invoices.
STRIPE_READ_ONLY_KEY=
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Replace these example event names with your actual event taxonomy.
POSTHOG_EVENT_MAP={"signup_started":"signup_started","signup_completed":"signup_completed","tracking_installed":"tracking_installed","pricing_page_views":"pricing_page_viewed","trial_started":"trial_started","paid_conversion":"subscription_paid"}
# OAuth token with https://www.googleapis.com/auth/webmasters.readonly.
# Refresh externally when it expires; no Google credential is sent to the browser.
GOOGLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE=
GITHUB_READ_ONLY_TOKEN=
GITHUB_REPOSITORY=
VERCEL_READ_ONLY_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1
# Configure prices for the selected provider/model. Omit for explicit unknown cost.
LLM_PRICING_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHED_INPUT_USD_PER_MILLION=
