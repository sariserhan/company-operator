# Next.js environment (.env.local). `npx convex dev` writes the Convex URLs.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Set ALL remaining values on the Convex backend, not NEXT_PUBLIC_ variables.
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=
OPERATOR_EMAIL=
# Enable only while creating your operator account on a private/local instance.
ALLOW_SIGNUP=false

# Stripe restricted key: read Customers, Subscriptions, Prices and Invoices.
STRIPE_READ_ONLY_KEY=
# Native VisitorPing endpoint (see docs/integrations.md).
VISITORPING_ANALYTICS_TOKEN=
VISITORPING_ANALYTICS_URL=https://visitorping.com/api/operator/analytics
# Temporary OAuth access token, OR all three renewal credentials below.
# Read-only scope: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE=
GITHUB_READ_ONLY_TOKEN=
GITHUB_REPOSITORY=
VERCEL_READ_ONLY_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Select Vercel AI Gateway and a provider/model ID in Settings.
AI_GATEWAY_API_KEY=
OPENAI_MODEL=gpt-4.1
# Configure prices for the selected provider/model. Omit for explicit unknown cost.
LLM_PRICING_MODEL=
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHED_INPUT_USD_PER_MILLION=
